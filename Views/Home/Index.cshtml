@{
    ViewData["Title"] = "Home";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #1e1b4b, #4c1d95);
        color: white;
        border-radius: 20px;
        padding: 70px 45px;
        margin-top: 35px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(76, 29, 149, 0.25);
    }

    .hero-section h1 {
        font-size: 3.2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .hero-section p {
        font-size: 1.2rem;
        color: #e9d5ff;
        margin-bottom: 30px;
    }

    .hero-button {
        display: inline-block;
        padding: 12px 24px;
        margin: 6px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

    .browse-button {
        background-color: white;
        color: #4c1d95;
    }

    .browse-button:hover {
        background-color: #ede9fe;
        color: #4c1d95;
    }

    .add-button {
        border: 1px solid white;
        color: white;
    }

    .add-button:hover {
        background-color: white;
        color: #4c1d95;
    }

    .features-section {
        margin-top: 45px;
    }

    .feature-card {
        background-color: white;
        border-radius: 15px;
        padding: 28px;
        height: 100%;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid #eee;
    }

    .feature-card h3 {
        color: #4c1d95;
        font-size: 1.3rem;
        margin-bottom: 12px;
    }

    .feature-card p {
        color: #666;
        margin-bottom: 0;
    }
</style>

<section class="hero-section">
    <h1>Welcome to MvcMovie 🎬</h1>

    <p>
        Manage your favorite movies in one simple place.
        Add, edit, search, and organize your movie collection.
    </p>

    <a class="hero-button browse-button"
       asp-controller="Movies"
       asp-action="Index">
        Browse Movies
    </a>

    <a class="hero-button add-button"
       asp-controller="Movies"
       asp-action="Create">
        Add New Movie
    </a>
</section>

<section class="features-section">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <h3>🎥 Movie Collection</h3>
                <p>View all saved movies in a clear and organized table.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <h3>🔎 Quick Search</h3>
                <p>Search for any movie instantly by its title.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <h3>✏️ Easy Management</h3>
                <p>Add, edit, view details, or delete movies whenever you need.</p>
            </div>
        </div>
    </div>
</section>