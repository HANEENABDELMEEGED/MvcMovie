@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<style>
    .create-page {
        max-width: 750px;
        margin: 45px auto;
    }

    .create-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.10);
        border: 1px solid #e9e9e9;
    }

    .create-card-header {
        background: linear-gradient(135deg, #1e1b4b, #6d28d9);
        color: white;
        padding: 28px 35px;
    }

    .create-card-header h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
    }

    .create-card-header p {
        margin: 8px 0 0;
        color: #e9d5ff;
    }

    .create-card-body {
        padding: 35px;
    }

    .create-card .form-label {
        color: #312e81;
        font-weight: 600;
    }

    .create-card .form-control {
        padding: 11px;
        border-radius: 9px;
    }

    .create-button {
        background-color: #6d28d9;
        border: none;
        padding: 11px 25px;
        font-weight: 600;
    }

    .create-button:hover {
        background-color: #5b21b6;
    }

    .back-link {
        color: #6d28d9;
        font-weight: 600;
        text-decoration: none;
    }

    .back-link:hover {
        color: #4c1d95;
        text-decoration: underline;
    }
</style>

<div class="create-page">
    <div class="create-card">

        <div class="create-card-header">
            <h1>🎬 Add New Movie</h1>
            <p>Fill in the details to add a movie to your collection.</p>
        </div>

        <div class="create-card-body">
            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" placeholder="Example: Interstellar" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ReleaseDate" class="form-label"></label>
                    <input asp-for="ReleaseDate" class="form-control" />
                    <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Genre" class="form-label"></label>
                    <input asp-for="Genre" class="form-control" placeholder="Example: Action" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" class="form-control" placeholder="Example: 250" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="PosterUrl" class="form-label"></label>
                    <input asp-for="PosterUrl"
                        class="form-control"
                        placeholder="Paste a poster image URL here" />
                    <span asp-validation-for="PosterUrl" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary create-button">
                    Save Movie
                </button>

                

                <a asp-action="Index" class="back-link ms-3">
                    ← Back to Movies
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}